<div class="card-grid">
    {% for p in items %}
    <a class="card" href="/projects/{{ p.slug }}/">
        <div class="card-body">
            <div class="card-title">{{ p.title }}</div>
            <p class="card-desc">{{ p.description }}</p>
            <div class="card-tags">
                {% for t in p.tags %}<span class="card-tag">{{ t }}</span>{% endfor %}
            </div>
        </div>
    </a>
    {% endfor %}
</div>
