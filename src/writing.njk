---
layout: base.njk
title: Writing
permalink: /writing/
---
<section class="section">
    <div class="section-heading">
        <span class="eyebrow">06 / Writing</span>
        <h2 class="section-title">Writing</h2>
    </div>
    <div class="writing-list">
        {% for p in collections.posts %}
        <a class="writing-item" href="{{ p.url }}">
            <div>
                <div class="writing-title">{{ p.data.title }}</div>
                <div class="writing-excerpt">{{ p.data.description }}</div>
            </div>
            <div class="writing-date">{{ p.date | monthYear }}</div>
        </a>
        {% endfor %}
    </div>
</section>
