title: Contact
permalink: /contact/
---
<section class="section">
    <div class="section-heading">
        <h2 class="section-title">Get in touch</h2>
    </div>
    <p>The fastest way to reach me is email. You can also connect with me on LinkedIn and GitHub.</p>
    <div class="contact-actions">
        <a class="btn btn-primary" id="email-link" data-enc="am9obm1iZXJnbWFuQGdtYWlsLmNvbQ=="><i class="fa-solid fa-envelope"></i> Send me an email</a>
        {% include "social.njk" %}
    </div>
    <noscript>
        <p class="contact-fallback">johnmbergman [at] gmail [dot] com</p>
    </noscript>
</section>

<script>
    // The address is base64-encoded so it never appears in the served HTML for
    // scrapers to harvest; the browser decodes it and builds the mailto link.
    (function () {
        var link = document.getElementById('email-link');
        link.href = 'mailto:' + atob(link.dataset.enc);
    })();
</script>
