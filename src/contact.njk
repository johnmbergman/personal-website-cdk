---
layout: base.njk
title: Contact
permalink: /contact/
---
<section class="section">
    <div class="section-heading">
        <span class="eyebrow">07 / Contact</span>
        <h2 class="section-title">Get in touch</h2>
    </div>
    <p class="contact-lede">The fastest way to reach me is email — or find me on LinkedIn and GitHub.</p>
    <div class="contact-actions">
        <a class="btn btn-primary" id="email-link" data-enc="{{ portfolio.profile.emailEncoded }}"><i class="fa-solid fa-envelope"></i> <span id="email-text">Email me</span></a>
        <div class="social-row">
            {% for s in portfolio.profile.social %}
            <a class="social" href="{{ s.href }}" target="_blank" rel="noreferrer" aria-label="{{ s.label }}"><i class="{{ s.icon }}"></i></a>
            {% endfor %}
        </div>
    </div>
    <noscript>
        <p class="contact-fallback">{{ portfolio.profile.emailHuman }}</p>
    </noscript>
</section>

<script>
    // The address is base64-encoded so it never appears in the served HTML for
    // scrapers to harvest; the browser decodes it and builds the mailto link.
    (function () {
        var link = document.getElementById('email-link');
        var address = atob(link.dataset.enc);
        link.href = 'mailto:' + address;
        document.getElementById('email-text').textContent = address;
    })();
</script>
